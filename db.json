  "reviews": [
    {
      "id": 1,
      "name": "Александр Петров",
      "rating": 5,
      "text": "Заказывали гриль-кухню для загородного дома. Качество превосходное — нержавеющая сталь, всё продумано до мелочей. Установили за один день. Жена в восторге, теперь каждые выходные готовим шашлыки!",
      "date": "2026-05-15",
      "verified": true
    },
    {
      "id": 2,
      "name": "Мария Иванова",
      "rating": 5,
      "text": "Долго выбирали между разными компаниями. Остановились на Grill и не пожалели. Менеджер помог с выбором конфигурации, учёл все наши пожелания. Кухня встала идеально на террасе.",
      "date": "2026-05-10",
      "verified": true
    },
    {
      "id": 3,
      "name": "Дмитрий Козлов",
      "rating": 5,
      "text": "Профессиональный подход от начала до конца. Замер, проект, изготовление, установка — всё на высшем уровне. Гриль-кухня стала центром притяжения на нашем участке. Соседи уже тоже хотят!",
      "date": "2026-05-05",
      "verified": true
    },
    {
      "id": 4,
      "name": "Елена Сидорова",
      "rating": 4,
      "text": "Хорошая кухня, качественная сборка. Единственный минус — пришлось немного подождать изготовления (3 недели вместо заявленных 2). Но результат того стоил. Рекомендую!",
      "date": "2026-04-28",
      "verified": true
    },
    {
      "id": 5,
      "name": "Игорь Новиков",
      "rating": 5,
      "text": "Взяли угловую модель с газовым грилем. Работает как часы! Температура регулируется отлично, мясо получается сочным. Очень доволен покупкой. Спасибо команде Grill!",
      "date": "2026-04-20",
      "verified": true
    },
    {
      "id": 6,
      "name": "Анна Волкова",
      "rating": 5,
      "text": "Подарили мужу на день рождения. Он в полном восторге! Теперь у нас семейная традиция — каждое воскресенье готовить на гриле. Кухня очень удобная, всё под рукой.",
      "date": "2026-04-15",
      "verified": true
    },
    {
      "id": 7,
      "name": "Сергей Морозов",
      "rating": 5,
      "text": "Третий год пользуемся — ни одной проблемы. Материал не ржавеет, покрытие не выгорает. Это действительно премиум-качество. Буду рекомендовать друзьям.",
      "date": "2026-04-10",
      "verified": true
    },
    {
      "id": 8,
      "name": "Ольга Белова",
      "rating": 5,
      "text": "Заказывали П-образную кухню для большого участка. Получилось просто шикарно! Много места для готовки, все гости в восторге. Отдельное спасибо дизайнеру за проект.",
      "date": "2026-04-05",
      "verified": true
    },
    {
      "id": 9,
      "name": "Виктор Лебедев",
      "rating": 5,
      "text": "Отличное соотношение цены и качества. Сравнивал с конкурентами — у Grill лучшее предложение. Установка прошла быстро, мастера аккуратные. Всё работает отлично!",
      "date": "2026-03-28",
      "verified": true
    },
    {
      "id": 10,
      "name": "Наталья Кузнецова",
      "rating": 5,
      "text": "Боялась заказывать онлайн, но всё прошло идеально. Менеджер подробно всё рассказал, прислал фото готового изделия до доставки. Кухня превзошла ожидания!",
      "date": "2026-03-20",
      "verified": true
    },
    {
      "id": 11,
      "name": "Андрей Соколов",
      "rating": 5,
      "text": "Купили модель с островком — это что-то невероятное! Готовить на свежем воздухе одно удовольствие. Качество материалов на высоте, всё продумано функционально.",
      "date": "2026-03-15",
      "verified": true
    },
    {
      "id": 12,
      "name": "Татьяна Орлова",
      "rating": 4,
      "text": "Хорошая кухня, но хотелось бы больше цветовых вариантов фасадов. В остальном — всё отлично. Гриль работает прекрасно, сборка качественная.",
      "date": "2026-03-10",
      "verified": true
    },
    {
      "id": 13,
      "name": "Павел Григорьев",
      "rating": 5,
      "text": "Лучшая покупка за последние годы! Каждые выходные собираем друзей на шашлыки. Кухня выдерживает любые нагрузки, легко моется. Однозначно рекомендую Grill!",
      "date": "2026-03-05",
      "verified": true
    },
    {
      "id": 14,
      "name": "Роман Васильев",
      "rating": 2,
      "text": "Кухня неплохая, но доставка задержалась на неделю без предупреждения. Пришлось брать отгул на работе. Саму кухню хвалить не буду — есть вопросы к качеству фурнитуры, один ящик заедает.",
      "date": "2026-02-28",
      "verified": false
    },
    {
      "id": 15,
      "name": "Кирилл Захаров",
      "rating": 2,
      "text": "Заказал композитный фасад, но цвет немного отличается от того, что был на сайте. Также ожидал более быструю сборку — мастера возились полдня. В целом нормально, но за такие деньги хотелось бы лучше.",
      "date": "2026-02-20",
      "verified": false
